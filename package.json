{
  "name": "qa-automation-playground",
  "private": true,
  "version": "1.0.0",
  "description": "QA Automation Labs - UI Automation Playground (practice environment for Playwright, Selenium and Cypress)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "npm run typecheck && vite build",
    "preview": "node server/index.js",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
