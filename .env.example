# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: SQLite file location (relative to the project root)
# DATABASE_FILE=data/playground.db

# Optional: override the API base URL used by the browser bundle
# VITE_API_BASE_URL=/api
